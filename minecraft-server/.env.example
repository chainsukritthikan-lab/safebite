# Copy this file to .env and edit it:   cp .env.example .env
# Then apply changes with:              docker compose up -d

# ---------------------------------------------------------------- basics ----
SERVER_NAME=SafeBite SMP
LEVEL_NAME=world
TZ=Asia/Bangkok

# survival | creative | adventure
GAMEMODE=survival

# peaceful | easy | normal | hard
DIFFICULTY=normal

MAX_PLAYERS=10

# Leave blank for a random world. Changing this AFTER the world is generated
# does nothing — you would need to delete ./data/worlds first.
LEVEL_SEED=

# Lets ops use /gamemode, /tp, /give etc. Harmless on a private 2-person server.
ALLOW_CHEATS=true


# ------------------------------------------------------------ who can join ---
# This is your lock on the front door. With ALLOW_LIST=true, only the accounts
# listed below can connect, even if someone else finds the IP.
#
# It starts OFF because an empty allowlist locks out everyone including you, and
# the easiest way to collect the XUIDs below is to let each person join once.
#
#   >>> Turn this to true once you and your friend have both joined.  <<<
#   >>> See Step 6 in README.md. Don't leave it off — scanners find   <<<
#   >>> open Bedrock servers within days.                             <<<
ALLOW_LIST=false

# Format: gamertag:xuid, comma-separated. You do not need to hunt down XUIDs
# up front — see Step 6 in README.md for the easy way.
#
#   ALLOW_LIST_USERS=YourGamertag:2535412345678901,FriendTag:2535498765432109
#
# You can also start with just names and no XUIDs:
#   ALLOW_LIST_USERS=YourGamertag,FriendTag
ALLOW_LIST_USERS=

# Admin accounts (comma-separated gamertags or XUIDs). Put your own here.
OPS=


# ------------------------------------------------------------ performance ----
# 12 is comfortable on the free 2-core VM. Higher = prettier but more CPU.
VIEW_DISTANCE=12
TICK_DISTANCE=4

# LATEST keeps the server current. Pin like 1.21.44.01 to freeze a version.
VERSION=LATEST


# ----------------------------------------- Geyser fallback only (see README) --
JAVA_VERSION=LATEST
JAVA_MEMORY=4G
# Bedrock players are prefixed with a dot here: .YourGamertag,.FriendTag
JAVA_WHITELIST=
JAVA_OPS=
# Same rule as ALLOW_LIST above: fill JAVA_WHITELIST first, then set this true.
ENFORCE_WHITELIST=false
